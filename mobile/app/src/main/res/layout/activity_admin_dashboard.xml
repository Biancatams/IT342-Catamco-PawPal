<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/green"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/pawlogo2"
            android:scaleType="fitCenter"
            android:contentDescription="PawPal Logo"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" PawPal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="4dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Panel"
            android:textSize="13sp"
            android:textColor="@color/peach"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Logout"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/terracotta" />
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Dashboard"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage pet listings, users, verifications, and reports."
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="16dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/cardPending"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvStatPendingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textSize="10sp"
                            android:textColor="@color/muted" />
                        <TextView
                            android:id="@+id/tvStatPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardApproved"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="14sp"
                            android:textColor="@color/green" />
                        <TextView
                            android:id="@+id/tvStatApprovedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approved"
                            android:textSize="10sp"
                            android:textColor="@color/muted" />
                        <TextView
                            android:id="@+id/tvStatApproved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardRejected"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✕"
                            android:textSize="14sp"
                            android:textColor="@color/terracotta" />
                        <TextView
                            android:id="@+id/tvStatRejectedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rejected"
                            android:textSize="10sp"
                            android:textColor="@color/muted" />
                        <TextView
                            android:id="@+id/tvStatRejected"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardTotal"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_background"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♡"
                            android:textSize="14sp"
                            android:textColor="@color/terracotta" />
                        <TextView
                            android:id="@+id/tvStatTotalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textSize="10sp"
                            android:textColor="@color/muted" />
                        <TextView
                            android:id="@+id/tvStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark" />
                    </LinearLayout>

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabPending"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Pending Review"
                            android:textSize="12sp"
                            android:background="@drawable/chip_inactive"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tabApproved"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Approved"
                            android:textSize="12sp"
                            android:background="@drawable/chip_inactive"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tabRejected"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="Rejected"
                            android:textSize="12sp"
                            android:background="@drawable/chip_inactive"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tabAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="All"
                            android:textSize="12sp"
                            android:background="@drawable/chip_inactive"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp"/>

                    </LinearLayout>
                </HorizontalScrollView>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llPetList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/llVerificationList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llUserList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llReportsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="No items found."
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="12dp">

        <FrameLayout
            android:id="@+id/navPets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/navIconPets"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_nav_pets"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/navBadgePets"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/nav_badge_background"
                        android:layout_gravity="top|end"
                        android:translationX="6dp"
                        android:translationY="-4dp"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:id="@+id/navLabelPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Listings"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </FrameLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/navIconHome"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_nav_home"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/navBadgeHome"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/nav_badge_background"
                        android:layout_gravity="top|end"
                        android:translationX="6dp"
                        android:translationY="-4dp"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:id="@+id/navLabelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Users"
                    android:textSize="10sp"
                    android:textColor="@color/green"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </FrameLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />

        <FrameLayout
            android:id="@+id/navVerification"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/navIconVerif"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_nav_verification"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/navBadgeVerif"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/nav_badge_background"
                        android:layout_gravity="top|end"
                        android:translationX="6dp"
                        android:translationY="-4dp"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:id="@+id/navLabelVerif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verifications"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </FrameLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" />

        <FrameLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/navIconReports"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_nav_reports"
                        android:layout_gravity="center" />
                    <TextView
                        android:id="@+id/navBadgeReports"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:textSize="9sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:background="@drawable/nav_badge_background"
                        android:layout_gravity="top|end"
                        android:translationX="6dp"
                        android:translationY="-4dp"
                        android:visibility="gone" />
                </FrameLayout>
                <TextView
                    android:id="@+id/navLabelReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports"
                    android:textSize="10sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>