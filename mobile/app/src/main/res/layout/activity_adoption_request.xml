<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/green"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvPetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill in your details to submit an adoption request."
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Name *"
                android:textSize="13sp"
                android:textColor="@color/dark"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAdopterName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/chip_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="14sp"
                android:textColor="@color/dark"
                android:hint="Full name"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Info *"
                android:textSize="13sp"
                android:textColor="@color/dark"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etContactInfo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/chip_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="14sp"
                android:textColor="@color/dark"
                android:hint="Phone number or email"
                android:inputType="text"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Why do you want to adopt? *"
                android:textSize="13sp"
                android:textColor="@color/dark"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etReason"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/chip_inactive"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="@color/dark"
                android:hint="Tell the owner why you'd be a great match..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note to Owner (optional)"
                android:textSize="13sp"
                android:textColor="@color/dark"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etNoteToOwner"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/chip_inactive"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="@color/dark"
                android:hint="Any additional message..."
                android:inputType="textMultiLine"
                android:gravity="top" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Submit Adoption Request"
            android:textColor="@color/white"
            android:backgroundTint="@color/terracotta"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>