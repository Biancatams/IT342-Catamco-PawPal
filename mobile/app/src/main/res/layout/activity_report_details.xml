<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            android:textSize="11sp"
            android:textColor="@color/white"
            android:background="@drawable/badge_pending"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- REPORT INFO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Date Reported"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚑ Reason"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.4"/>

            </LinearLayout>

            <!-- REPORTER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reporter"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivReporterAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/pawlogo2"
                        android:scaleType="centerCrop"
                        android:background="@drawable/chip_inactive"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReporterName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark"/>

                        <TextView
                            android:id="@+id/tvReporterEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/muted"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- REPORTED USER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reported User"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark"/>

                    <TextView
                        android:id="@+id/tvBannedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BANNED"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:background="@drawable/badge_declined"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivReportedAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/pawlogo2"
                        android:scaleType="centerCrop"
                        android:background="@drawable/chip_inactive"
                        android:layout_marginEnd="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReportedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/dark"/>

                        <TextView
                            android:id="@+id/tvReportedEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/muted"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ADOPTION REQUEST CARD (shown only when relevant) -->
            <LinearLayout
                android:id="@+id/cardAdoptionRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Adoption Request Reference"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvArAdopterName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvArContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvArReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvArNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/dark"
                    android:background="@drawable/chip_inactive"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.4"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- REPORTED USER'S PETS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User's Pet Listings"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <ProgressBar
                    android:id="@+id/progressBarPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/llPetCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tvNoPets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No pet listings found for this user."
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- ADMIN ACTION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Action"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/peach"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnBanUser"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🚫  Ban This User"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/terracotta"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnIgnore"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Ignore"
                        android:textColor="@color/dark"
                        android:backgroundTint="@color/peach"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btnResolve"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="✓ Resolved"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/green"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>